{
  "name": "physics",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:browser": "playwright test; status=$?; astro preview stop; exit $status",
    "coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.mjs\" -f ./scripts/eslint-gh-formatter.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:dup": "jscpd --config .jscpd.json",
    "check:styles": "stylelint \"src/**/*.{astro,css}\"",
    "check:knip": "knip"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.1",
    "katex": "^0.18.4",
    "nanostores": "^1.4.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "jscpd": "^4.2.5",
    "knip": "^6.32.2",
    "postcss-html": "^1.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "minimatch": "^10.2.3"
  }
}
