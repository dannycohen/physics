---
import LandingLayout from '../../components/LandingLayout.astro';
import { getCatalog } from '../../lib/catalog';

const { live, byCategory } = await getCatalog();
const hero = live[0];
const base = import.meta.env.BASE_URL;
---

<LandingLayout
  current="home/list"
  title="The full catalog"
  description="Every interactive physics equation on the site, listed by domain."
>
  {
    hero && (
      <p class="hero-link">
        <strong>Start here:</strong>{' '}
        <a href={`${base}viz/${hero.id}/`}>{hero.data.title}</a> — {hero.data.claim}
      </p>
    )
  }

  {
    byCategory.map((group) => (
      <section>
        <h2>{group.label}</h2>
        <ul>
          {group.entries.map((e) =>
            e.data.status === 'live' ? (
              <li>
                <a href={`${base}viz/${e.id}/`}>{e.data.title}</a> — {e.data.claim}
              </li>
            ) : (
              <li>
                <span class="coming-soon">{e.data.title} (coming soon)</span>
              </li>
            ),
          )}
        </ul>
      </section>
    ))
  }
</LandingLayout>

<style>
  .coming-soon {
    color: var(--color-text-muted);
  }
  .hero-link {
    background: var(--color-surface);
    padding: var(--space-3);
    border-radius: var(--radius);
  }
</style>
